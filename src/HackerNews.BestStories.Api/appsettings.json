{
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/",
    "MaxStoriesRequestLimit": 100,
    "MaxConcurrentRequests": 10,
    "BestStoryIdsCacheMinutes": 5,
    "StoryDetailsCacheMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
